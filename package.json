{
  "name": "hiphouse",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "docker compose up -d --wait db && concurrently -k -n api,web -c cyan,magenta \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "cd apps/api && go run .",
    "dev:web": "pnpm --filter @hiphouse/web dev",
    "crawl": "pnpm --filter @hiphouse/crawler crawl",
    "search": "pnpm --filter @hiphouse/crawler search",
    "artist": "pnpm --filter @hiphouse/crawler search"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
